# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# IDE and editors
.idea/
.vscode/

# Dependencies
node_modules/
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# Production builds
/build
dist/
dist

# Environment files
.env
.env.local
.env.development
.env.production
.env.*.local
# Keep .env.example for documentation
!.env.example

# Credentials and secrets
*token.json*
*credentials.json*

# Logs and debug files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dump.rdb
logs/
*.log

# System files
.DS_Store
*.pem

# Python
__pycache__/
*pyc*
venv/
.venv/

# Development tools
chainlit.md
.chainlit
.ipynb_checkpoints/
.ac

# Deployment
.vercel

# Data and databases
agenthub/agents/youtube/db

# Archive files and large assets
**/*.zip
**/*.tar.gz
**/*.tar
**/*.tgz
*.pack
*.deb
*.dylib

# Build caches
.cache/

# Mobile development
android-sdk/

# Uploads (keep folder structure but not files)
public/uploads/jobdesk-attachments/*
!public/uploads/jobdesk-attachments/.gitkeep
public/uploads/profiles/*
!public/uploads/profiles/.gitkeep
public/uploads/billing/*
!public/uploads/billing/.gitkeep

# Backup files
backups/
*.bak

# Desktop app installers (too large for git)
public/downloads/*.dmg
public/downloads/*.exe
public/downloads/*.AppImage
public/downloads/*.zip
public/downloads/*.blockmap
public/downloads/*.yml
!public/downloads/.gitkeep
# Semua artefak rilis (installer + file blockmap + feed update .yml) sengaja
# TIDAK lewat git — harus di-upload bersamaan langsung ke server via
# electron-app/scripts/release.sh, supaya .yml dan installer selalu sinkron.
# Kalau .yml ikut ter-commit tapi installer-nya tidak, electron-updater di
# karyawan akan menunjuk ke file yang tidak ada di server.
electron-app/dist/
